# Copie para .env (make setup faz isto). Lido pelo docker compose e, dentro dos contentores, pelo Laravel.

# Contentores
HOST_UID=1000
HOST_GID=1000
HTTP_PORT=8000
VITE_HOST_PORT=5180
DB_HOST_PORT=55432
POSTGRES_VERSION=16

# Laravel
APP_NAME="Plataforma de Gestão Educativa"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_LOCALE=pt
APP_FALLBACK_LOCALE=pt
LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=school
DB_USERNAME=school
DB_PASSWORD=school

SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync
MAIL_MAILER=log

# Frontend (origem que pode iniciar sessão por cookie)
FRONTEND_URL=http://localhost:5180
SANCTUM_STATEFUL_DOMAINS=localhost:5180

# Em produção: APP_ENV=production, APP_DEBUG=false, APP_URL=https://o-seu-dominio,
# FRONTEND_URL=https://o-seu-dominio, SANCTUM_STATEFUL_DOMAINS=o-seu-dominio,
# DB_PASSWORD forte, SESSION_SECURE_COOKIE=true, HTTP_PORT=8080.
